{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    ":automergeAll"
  ],
  "prHourlyLimit": 1,
  "lockFileMaintenance": {
    "enabled": true,
    "extends": [
      "schedule:weekly"
    ]
  },
  "nix": {
    "enabled": true
  },
  "packageRules": [
    {
      "description": "Tofu PRs must never automerge: pipelines plan on PRs; the apply-based merge should be a conscious human decision.",
      "matchFileNames": [
        "tofu/**"
      ],
      "automerge": false
    },
    {
      "description": "Belt for the terraform manager outside tofu/**.",
      "matchManagers": [
        "terraform"
      ],
      "automerge": false
    }
  ]
}
