use flake

export $(sops -d secrets.json | jq -r 'to_entries | map("\(.key)=\(.value)") | .[]')

modules=(dns object-storage network proxmox proxmox-new)
for module in "${modules[@]}"; do
    SECRETS_FILE="$module/secrets.json"
    if [ -f "$SECRETS_FILE" ]; then
        # Decrypt in-memory and export each key as TF_VAR_<key>
        eval "$(
            sops --decrypt "$SECRETS_FILE" | \
            jq -r 'to_entries | map("export TF_VAR_\(.key)=\(.value)") | .[]'
        )"
    fi
done
