{
  flake.modules.homeManager.paperless-upload =
    {
      config,
      lib,
      pkgs,
      ...
    }:
    let
      # srv-prod-2 runs the nixpkgs paperless module without setting
      # `services.paperless.consumptionDir`, so scans land in the module's
      # default consume dir (mediaDir only relocates the NFS media root).
      consumeDir = "/var/lib/paperless/consume";
      # Alias from ~/.ssh/config, generated by the ssh-home-lab aspect.
      remoteHost = config.home-lab.hosts.srv-prod-2.dns;
      dropDir = "${config.home.homeDirectory}/Documents/paperless";

      upload = pkgs.writeShellApplication {
        name = "paperless-upload";
        runtimeInputs = with pkgs; [
          coreutils
          openssh
        ];
        text = ''
          drop_dir="''${1:-}"

          status=0
          shopt -s nullglob
          for file in "$drop_dir"/*; do
            [[ -f $file ]] || continue

            # Skip files the scanner may still be writing: untouched for the
            # last 10 seconds and size unchanged across a 3 second re-check.
            if (( $(date +%s) - $(stat -c %Y "$file") < 10 )); then
              continue
            fi
            size_before=$(stat -c %s "$file")
            sleep 3
            size_after=$(stat -c %s "$file" 2>/dev/null) || continue
            if (( size_before != size_after )); then
              continue
            fi

            name=$(basename "$file")
            staging_path="${consumeDir}/.staging-$name"
            final_path="${consumeDir}/$name"

            # scp to a hidden staging name (paperless ignores dotfiles in the
            # consume dir), then rename on the server, so the consumer only
            # ever sees complete files. On success the local copy is deleted;
            # on failure it is kept and retried on the next timer tick.
            if
              scp -q -o BatchMode=yes -o ConnectTimeout=10 -- "$file" "${remoteHost}:$staging_path" &&
                ssh -o BatchMode=yes -o ConnectTimeout=10 "${remoteHost}" "mv -- ''${staging_path@Q} ''${final_path@Q}"
            then
              rm -- "$file"
              echo "uploaded: $name"
            else
              ssh -o BatchMode=yes -o ConnectTimeout=10 "${remoteHost}" "rm -f -- ''${staging_path@Q}" || true
              echo "upload failed, will retry on the next timer tick: $name" >&2
              status=1
            fi
          done
          exit "$status"
        '';
      };
    in
    {
      systemd.user.tmpfiles.rules = [
        "d ${dropDir} 0700 - - -"
      ];

      systemd.user.services.paperless-upload = {
        Unit.Description = "Upload scanned documents to paperless on srv-prod-2";
        Service = {
          Type = "oneshot";
          # ssh needs HOME to find ~/.ssh/config and the key (ssh-home-lab).
          Environment = [ "HOME=${config.home.homeDirectory}" ];
          ExecStart = "${lib.getExe upload} ${dropDir}";
        };
      };

      systemd.user.timers.paperless-upload = {
        Unit.Description = "Upload scanned documents to paperless every two minutes";
        Install.WantedBy = [ "timers.target" ];
        Timer = {
          # A timer instead of an inotify path unit: a failed upload (server
          # unreachable, laptop suspended) is retried on the next tick, and
          # Persistent replays missed ticks after suspend or reboot.
          OnCalendar = "*:0/2";
          Persistent = true;
        };
      };
    };
}
